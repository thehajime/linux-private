# Kernel options needed by the Linux-private LTP runtime matrix.
# Keep this in the kernel CI checkout: LTP source refs may not carry the
# downstream tools/buildroot/ltp-add.config helper.
CONFIG_BLK_DEV_LOOP=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_EXT4_FS=y
CONFIG_KEYS=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_OVERLAY_FS=y
